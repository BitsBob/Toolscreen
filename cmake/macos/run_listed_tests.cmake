# Runs every case a Toolscreen test binary lists (`<binary> --list`, then `<binary> --run <case>`).
# Usage: cmake -DTEST_BINARY=<path> -P run_listed_tests.cmake
execute_process(COMMAND "${TEST_BINARY}" --list OUTPUT_VARIABLE cases RESULT_VARIABLE list_result)
if(NOT list_result EQUAL 0)
    message(FATAL_ERROR "${TEST_BINARY} --list failed (${list_result})")
endif()
string(REPLACE "\n" ";" cases "${cases}")
set(failed "")
set(count 0)
foreach(test_case IN LISTS cases)
    string(STRIP "${test_case}" test_case)
    if(test_case STREQUAL "")
        continue()
    endif()
    math(EXPR count "${count} + 1")
    execute_process(COMMAND "${TEST_BINARY}" --run "${test_case}" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0)
        list(APPEND failed "${test_case}")
        message("FAIL ${test_case}\n${out}${err}")
    endif()
endforeach()
if(failed)
    message(FATAL_ERROR "Failed cases: ${failed}")
endif()
message("All ${count} cases passed")
